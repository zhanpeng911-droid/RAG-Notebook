# ==============================================
# Docker环境配置 - Django用户服务
# ==============================================

# JWT配置
# 必须显式注入，禁止弱默认值（防伪造 token）；本地: export JWT_SECRET_KEY=<随机32+位>
JWT_SECRET_KEY=${JWT_SECRET_KEY:?JWT_SECRET_KEY is required}

# 数据库配置（使用Docker服务名）
DB_HOST=mysql
DB_PORT=3306
DB_NAME=chat_history
DB_USER=${MYSQL_USER:-notebook_user}
DB_PASSWORD=${MYSQL_PASSWORD:-change-me-local-app-password}

# Celery配置
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240
CELERY_RESULT_EXPIRES=3600

# Redis缓存配置
# Redis 已开 requirepass，URL 必须带密码（否则静默降级 LocMem，token 吊销失效）
REDIS_CACHE_URL=redis://:${REDIS_PASSWORD:-change-me-local-redis-password}@redis:6379/0

# Django配置
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend
