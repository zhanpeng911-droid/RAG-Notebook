# ==============================================
# Docker环境配置 - 后端服务
# ==============================================

# 运行环境
ENV=production

# LLM 大模型配置
LLM_TYPE=ALIYUN

# 阿里云百炼配置
ALIYUN_ACCESS_KEY_SECRET=${ALIYUN_ACCESS_KEY_SECRET:-your_api_key}
ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL_NAME=qwen3-max

# 向量嵌入模型配置
EMBED_MODEL_TYPE=ALIYUN
ALIYUN_EMBED_MODEL_NAME=qwen3-embedding
DASHSCOPE_API_KEY=${DASHSCOPE_API_KEY:-your_dashscope_api_key}

# 多模态视觉模型配置
VISION_MODEL_TYPE=ALIYUN
VISION_CHAT_MODEL_NAME=qwen3-max

# 视觉模型批处理优化配置
VISION_BATCH_SIZE=5
VISION_DEDUP_ENABLED=true
VISION_DEDUP_THRESHOLD=10
VISION_BATCH_LOW_RES=true

# 重排序模型配置（Docker中使用默认路径）
RERANKER_MODEL_PATH=/app/models/reranker

# 数据库配置（使用Docker服务名）
MYSQL_USER=${MYSQL_USER:-rag_user}
MYSQL_PASSWORD=${MYSQL_PASSWORD:-change-me-local-app-password}
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=chat_history

# Redis配置（使用Docker服务名）
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# 限流配置
RATE_LIMIT_ENABLED=false

# Django API地址（使用Docker服务名）
DJANGO_API_URL=http://django:8001

# JWT身份验证配置
SECRET_KEY=${JWT_SECRET_KEY:-replace-me-before-shared-use}
ALGORITHM=HS256

# CORS配置
CORS_ORIGINS=http://localhost:3000,http://frontend,http://localhost
