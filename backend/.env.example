# ==============================================
# 环境配置
# ==============================================
ENV=dev
DEBUG_MODE=true

# ==============================================
# JWT 身份验证配置
# ==============================================
SECRET_KEY=MY_JWT_SECRET_KEY_REPLACE_ME
ALGORITHM=HS256
# JWT 黑名单检查开关（默认开启，生产环境建议保持 true）
JWT_BLACKLIST_CHECK_ENABLED=true
# JWT 黑名单专用 Redis URL（为空则使用主 Redis 配置）
JWT_BLACKLIST_REDIS_URL=

# ==============================================
# MySQL 配置
# ==============================================
MYSQL_USER=notebook_user
MYSQL_PASSWORD=change-me-local-db-password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=chat_history

# ==============================================
# Redis 配置
# ==============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=3
REDIS_PASSWORD=
# Redis 缓存 URL（可选，用于 JWT 黑名单等场景）
REDIS_CACHE_URL=

# ==============================================
# Django 用户服务
# ==============================================
# Django API 地址，用于调用用户服务的 API（注册、登录、用户信息等）
DJANGO_API_URL=http://127.0.0.1:8001

# ==============================================
# CORS 跨域配置
# ==============================================
# 允许的前端源地址，多个用逗号分隔
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ==============================================
# 限流配置
# ==============================================
# 全局限流开关：设为 false 可禁用所有路由上的 rate_limit 依赖
# 开发调试阶段建议设为 false，生产环境建议设为 true 并配合具体阈值
RATE_LIMIT_ENABLED=false

# 允许修改进程级检索参数的用户 ID，多个用逗号分隔；为空时禁止 PUT/RESET
RUNTIME_CONFIG_ADMIN_USER_IDS=


# ==============================================
# LLM 大模型配置
# ==============================================
# LLM类型：ALIYUN(阿里云百炼) | OLLAMA(本地模型) | OPENAI(DeepSeek等OpenAI兼容)
LLM_TYPE=OLLAMA

# ==============================================
# Ollama 配置（仅 LLM_TYPE=OLLAMA 时生效）
# ==============================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=qwen3.5:0.8b
OLLAMA_CHAT_MODEL_NAME=

# ==============================================
# 阿里云百炼配置（仅 LLM_TYPE=ALIYUN 时生效），可能产生费用，注意控制用量
# ==============================================
# 阿里云 API Key（格式：sk-xxxx）
# 申请地址：https://dashscope.console.aliyun.com/
ALIYUN_ACCESS_KEY_SECRET=your_api_key
# 阿里云 API 地址
ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 阿里云聊天模型名称
CHAT_MODEL_NAME=qwen3-max
ALIYUN_MODEL_NAME=

# ==============================================
# OpenAI 兼容配置（仅 LLM_TYPE=OPENAI 时生效）
# ==============================================
OPENAI_API_KEY=your_openai_compatible_api_key
# API 地址（DeepSeek: https://api.deepseek.com）
OPENAI_API_BASE=https://api.deepseek.com

# ==============================================
# 通用 LLM 配置
# ==============================================
# 通用 Chat API Key（优先级低于各 provider 专用 key）
CHAT_API_KEY=
# 允许的 LLM Base URL 白名单，多个用逗号分隔
ALLOWED_LLM_BASE_URLS=

# ==============================================
# 向量嵌入模型配置
# ==============================================
# 嵌入模型类型：OLLAMA | ALIYUN
EMBED_MODEL_TYPE=OLLAMA
# Ollama 嵌入模型（需提前下载），当EMBED_MODEL_TYPE=OLLAMA时使用
TEXT_EMBEDDING_MODEL_NAME=qwen3-embedding:0.6b
# 阿里云嵌入模型（当EMBED_MODEL_TYPE=ALIYUN时使用），需确保阿里云百炼平台有该模型且账户余额充足
ALIYUN_EMBED_MODEL_NAME=qwen3-embedding
# DashScope API Key（阿里云嵌入模型专用，与 ALIYUN_ACCESS_KEY_SECRET 二选一）
DASHSCOPE_API_KEY=your_dashscope_api_key

# ==============================================
# 多模态视觉模型配置（用于PDF多模态图片描述）
# ==============================================
# 视觉模型类型：ALIYUN | OLLAMA；为空则沿用 LLM_TYPE
VISION_MODEL_TYPE=
VISION_CHAT_MODEL_NAME=
VISION_OLLAMA_MODEL_NAME=

# ==============================================
# 视觉模型批处理优化配置（降低API调用次数和延迟）
# ==============================================
VISION_BATCH_SIZE=5
VISION_DEDUP_ENABLED=true
VISION_DEDUP_THRESHOLD=10
VISION_BATCH_LOW_RES=true

# ==============================================
# 重排序模型配置
# ==============================================
RERANKER_MODEL_PATH=

# ==============================================
# LangSmith 调试追踪（可选）
# ==============================================
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=my-fastapi-langchain-project
# 企业 Org/Space/审计 API（默认关闭）
FEATURE_ORG=true
