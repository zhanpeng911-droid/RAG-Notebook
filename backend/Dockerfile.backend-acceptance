FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.12.1 /uv /uvx /bin/
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl build-essential libmagic1 libmupdf-dev \
    && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml uv.lock ./
# The locked wheel hashes and versions are unchanged. Only the artifact host is
# substituted when the configured Tsinghua mirror is unreachable from Docker.
RUN python -c "from pathlib import Path; p=Path('uv.lock'); p.write_text(p.read_text().replace('https://pypi.tuna.tsinghua.edu.cn/packages/', 'https://files.pythonhosted.org/packages/'))"
# Build-system requirements (setuptools/wheel for the jieba sdist) must use the
# same reachable index, not the Tsinghua default embedded in pyproject.toml.
ENV UV_DEFAULT_INDEX=https://pypi.org/simple \
    UV_INDEX_URL=https://pypi.org/simple \
    UV_HTTP_TIMEOUT=600 \
    PIP_INDEX_URL=https://pypi.org/simple \
    PIP_TRUSTED_HOST=pypi.org
RUN uv sync --frozen --extra dev --no-install-project --default-index https://pypi.org/simple
COPY app ./app
COPY main.py alembic.ini ./
COPY alembic ./alembic
COPY tests_real ./tests_real
COPY tools/backend_acceptance ./tools/backend_acceptance
RUN uv sync --frozen --extra dev --default-index https://pypi.org/simple \
    && mkdir -p /app/data /app/logs
ENV PATH="/app/.venv/bin:$PATH"
CMD ["sh", "-c", "alembic upgrade head && uvicorn main:app --host 0.0.0.0 --port 8000"]
