# Docker Compose variables for local development
# Copy to .env at the repository root before running docker compose.
# Replace every change-me or replace-me placeholder before starting containers.

MYSQL_ROOT_PASSWORD=change-me-local-root-password
MYSQL_DATABASE=chat_history
MYSQL_USER=rag_user
MYSQL_PASSWORD=change-me-local-app-password
MYSQL_PORT=3306
REDIS_PORT=6379

JWT_SECRET_KEY=replace-with-a-long-random-string

# Optional model provider keys for backend/.env.docker
ALIYUN_ACCESS_KEY_SECRET=
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
